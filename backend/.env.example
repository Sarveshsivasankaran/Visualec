APP_NAME=Visualec
APP_ENV=development
DATABASE_URL=sqlite:///./visualec.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=24
AUTO_START_CAMERA=true
DETECTION_MODEL=visualec-pico.espdl
DETECTION_INPUT_SIZE=288
DETECTION_CONFIDENCE=0.45
INFERENCE_INTERVAL_MS=20
ACTIVATION_DELAY_SECONDS=1
DEACTIVATION_DELAY_SECONDS=10
CAMERA_LOSS_SAFETY_TIMEOUT=30
CAMERA_LOSS_ACTION=off
ESP32_BASE_URL=http://visualec-esp32-s3.local
ESP32_TIMEOUT_SECONDS=3
RELAY_RETRIES=2
ENERGY_TARIFF_PER_KWH=8.00
EDGE_DEVICE_TOKEN=replace-with-a-long-random-token
EDGE_EXPECTED_MODEL_SHA256=
EDGE_INPUT_WIDTH=288
EDGE_INPUT_HEIGHT=160
EDGE_HIGH_MOTION_FPS=8
EDGE_MEDIUM_MOTION_FPS=4
EDGE_LOW_MOTION_FPS=1
EDGE_MANDATORY_REFRESH_SECONDS=1
EDGE_INFERENCE_TIMEOUT_SECONDS=1
EDGE_OCCUPANCY_HEARTBEAT_SECONDS=0.5
EDGE_MOTION_PIXEL_THRESHOLD=20
EDGE_MOTION_HIGH_THRESHOLD=0.06
EDGE_MOTION_MEDIUM_THRESHOLD=0.015
