APP_NAME=Visualec
APP_ENV=development
DATABASE_URL=sqlite:///./visualec.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=24
AUTO_START_CAMERA=true
DETECTION_MODEL=yolov8n.onnx
DETECTION_INPUT_SIZE=320
DETECTION_CONFIDENCE=0.45
INFERENCE_INTERVAL_MS=20
ACTIVATION_DELAY_SECONDS=1
DEACTIVATION_DELAY_SECONDS=10
CAMERA_LOSS_SAFETY_TIMEOUT=30
CAMERA_LOSS_ACTION=off
ESP32_BASE_URL=http://visualec-esp32-s3.local
ESP32_TIMEOUT_SECONDS=3
RELAY_RETRIES=2
ENERGY_TARIFF_PER_KWH=8.00
